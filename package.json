{
  "name": "land-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web implementation of the Basic Land Game (MTG homebrew variant)",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.board.json",
    "test": "node --test 'test/**/*.spec.ts'",
    "demo": "node demo/demo.ts",
    "smoke": "node scripts/smoke-browser.mjs",
    "bench": "node scripts/bench-bot.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "trystero": "0.26.0"
  }
}
